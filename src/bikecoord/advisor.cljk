(ns bikecoord.advisor
  "Bicycle Repair Coordination Advisor — proposing a bicycle-repair-
  workshop scheduling/logistics coordination operation (log a work
  record, schedule a crew operation, flag a safety concern, coordinate
  a bicycle-parts supply order) from a crew roster, shop registration
  and safety-reporting policy. Swappable mock/llm; the advisor ONLY
  proposes — `bikecoord.governor` independently gates every proposal
  and always escalates safety concerns and above-threshold supply
  orders. The advisor never proposes to directly finalize a
  repair-execution decision (e.g. deciding to proceed with or
  complete a specific repair job) or a roadworthiness-clearance
  decision (declaring a bicycle safe to ride or sell), and never
  proposes to override a shop safety officer's judgment — those stay
  permanently out of this actor's scope. Modeled closely on
  cloud-itonami-isco-7211's foundrycoord.advisor (closest
  workshop-mechanical-safety domain shape).

  A proposal: {:op :log-work-record|:schedule-crew-operation|
               :flag-safety-concern|:coordinate-supply-order
               :effect :propose :repairer-id str :shop-id str
               :cost number :hazard-type kw :task str :stake kw
               :confidence n :rationale str}"
  (:require #?(:clj [kotoba.lang.edn :as edn] :cljs [cljs.reader :as edn])))

(defprotocol Advisor
  (-advise [advisor store request] "request -> proposal map"))

(defn- rationale-for [op repairer-id shop-id hazard-type]
  (case op
    :log-work-record
    (str "logged work record for repairer " repairer-id " at shop " shop-id)

    :schedule-crew-operation
    (str "scheduled crew operation for repair-bay task at shop " shop-id)

    :flag-safety-concern
    (str "flagged " (name (or hazard-type :hazard)) " concern for repairer "
         repairer-id " at shop " shop-id " — routed for shop safety officer review")

    :coordinate-supply-order
    (str "coordinated supply order for repairer " repairer-id " at shop " shop-id)

    (str "proposed " (name op) " for repairer " repairer-id " at shop " shop-id)))

(defn- infer [_store {:keys [op stake repairer-id shop-id cost hazard-type task]
                       :as request}]
  {:op op
   :effect :propose
   :repairer-id repairer-id
   :shop-id shop-id
   :cost cost
   :hazard-type hazard-type
   :task task
   :stake (or stake :low)
   :confidence (case (or stake :low) :high 0.7 :medium 0.85 :low 0.95)
   :rationale (rationale-for op repairer-id shop-id hazard-type)})

(defn mock-advisor []
  (reify Advisor
    (-advise [_ store request] (infer store request))))

(def ^:private system-prompt
  "You are a bicycle-repair-workshop scheduling/logistics coordination
   advisor. Given a request, propose an :op (one of :log-work-record,
   :schedule-crew-operation, :flag-safety-concern,
   :coordinate-supply-order), the :repairer-id, :shop-id, and any
   :cost/:hazard-type/:task fields, an honest :confidence and a
   :stake. Never propose an op outside this closed list, and never
   propose to directly finalize a repair-execution decision (e.g.
   deciding to proceed with or complete a specific repair job) or a
   roadworthiness-clearance decision (declaring a bicycle safe to
   ride or sell), or to override a shop safety officer's judgment —
   those are always out of this actor's scope; it coordinates
   workshop scheduling/logistics only and never performs repair work
   or makes roadworthiness-clearance decisions itself. Safety
   concerns always require human sign-off regardless of confidence.")

(defn- parse-proposal [content]
  (try
    (let [p (edn/read-string content)]
      (if (map? p)
        (assoc p :effect :propose)
        {:op :unknown :effect :propose :confidence 0.0 :stake :high
         :rationale "unparseable LLM response"}))
    (catch #?(:clj Exception :cljs js/Error) _
      {:op :unknown :effect :propose :confidence 0.0 :stake :high
       :rationale "LLM response parse failure"})))

(defn llm-advisor
  [chat-model model-generate-fn gen-opts]
  (reify Advisor
    (-advise [_ _store request]
      (let [msgs [{:role :system :content system-prompt}
                  {:role :user :content (str "operation request: " (pr-str request))}]
            resp (model-generate-fn chat-model msgs gen-opts)]
        (parse-proposal (:content resp))))))
