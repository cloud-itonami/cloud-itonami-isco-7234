;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a bicycle-repair-workshop scheduling/logistics
;; coordination robot handles crew scheduling, repair-job/inventory records
;; and parts supply orders for a bicycle repair shop (ISCO 7234). Its physical
;; work: lifting a bicycle from the floor into the repair-stand clamp, carrying
;; parts (wheelsets, tyres, drivetrain parts) from the stockroom to the bench,
;; and the incoming-parts check of a replacement spoke under tension.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7234"
 :cases
 [{:id :bike-into-repair-stand
   :kind :manipulator
   :procedure "arm lifts a bicycle from the workshop floor into the repair-stand clamp"
   :params {:l1-m 0.60 :l2-m 0.50 :m1-kg 8.0 :m2-kg 6.0
            :from [0.70 0.15] :to [0.35 0.90] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [8.0 11.0 14.0 18.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 250.0 :basis "estimate: continuous shoulder torque of a 20 kg-payload class collaborative arm at ~1.1 m reach"}
   :boundary {:lo 1.0 :hi 60.0}}
  {:id :parts-cart-to-bench
   :kind :transport
   :procedure "parts cart carries wheelsets, tyres and drivetrain parts from the stockroom to the repair bench"
   :params {:mass-kg 50.0 :distance-m 25.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 120.0 :crr 0.02
            :cog-height-m 0.50 :support-half-length-m 0.30 :max-time-s 1200.0}
   :sweep {:param :payload-kg :values [5.0 15.0 30.0 60.0 100.0]}
   :quantity :cycle-time-s
   :limit {:max 35.0 :basis "estimate: one stockroom-to-bench leg inside a 1-minute parts turnaround so a mechanic is not left waiting at the stand"}
   :boundary {:lo 1.0 :hi 800.0}}
  {:id :spoke-tension-check
   :kind :material
   :procedure "incoming check pulls a 2.0 mm stainless replacement spoke to the wheel-building tension and beyond"
   :params {:length-m 0.29 :area-m2 3.14e-6 :youngs-modulus-pa 193.0e9
            :yield-stress-pa 1100.0e6 :hardening-pa 2.0e9 :density-kg-m3 7900.0}
   :sweep {:param :max-force-n :values [800.0 1200.0 2000.0 3000.0 4000.0]}
   :quantity :final-strain
   :limit {:max 0.005 :basis "estimate: stay elastic -- cold-drawn stainless spoke wire yields near 1100 MPa, i.e. ~0.0057 strain at E = 193 GPa"}
   :boundary {:lo 500.0 :hi 5000.0}}]}
